{
  "name": "transponder-app",
  "version": "1.5.5",
  "private": true,
  "homepage": "https://mypreflight.io",
  "author": "mypreflight",
  "license": "Unlicense",
  "description": "The desktop companion app for MyPreflight platform.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:exe": "bun bin/build-exe.mjs",
    "build:icon": "node bin/make-icon.mjs",
    "start": "ts-node src/main.ts",
    "start:dev": "ts-node-dev --respawn src/main.ts",
    "preview": "node bin/preview.mjs",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "lint:ci": "biome ci src",
    "format:fix": "biome format --write src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "node-simconnect": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "glob@>=9.0.0 <14.0.2": "^14.0.4"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "@parcel/watcher": false
  }
}
